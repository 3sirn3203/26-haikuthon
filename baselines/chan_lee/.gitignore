# chan_lee 전용 ignore 규칙 (루트 .gitignore는 건드리지 않음)

# 루트의 `test*/` 규칙이 tests/를 무시하므로 다시 포함한다
!tests/

# 가상환경, 캐시, 데이터, 모델 가중치
.venv/
cache/
data/
checkpoints/
*.npy
*.npz
*.pt
*.pth
*.safetensors
*.parquet

# 대용량/기밀 산출물: 제출 CSV와 문항별 예측은 커밋하지 않는다
submissions/
results/**/predictions*
results/**/*.csv
!results/leaderboard.csv

__pycache__/
.pytest_cache/
.ipynb_checkpoints/
